{
  "multipart": [
    {
      "apply": {
        "model": "terracraft_geo:block/pipe_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_side",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_side",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_side",
        "x": 90
      }
    },
    {
      "when": {
        "flange_north": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_flange"
      }
    },
    {
      "when": {
        "flange_east": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_flange",
        "y": 90
      }
    },
    {
      "when": {
        "flange_south": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_flange",
        "y": 180
      }
    },
    {
      "when": {
        "flange_west": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_flange",
        "y": 270
      }
    },
    {
      "when": {
        "flange_up": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_flange",
        "x": 270
      }
    },
    {
      "when": {
        "flange_down": "true"
      },
      "apply": {
        "model": "terracraft_geo:block/pipe_flange",
        "x": 90
      }
    }
  ]
}
